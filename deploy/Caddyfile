# Reverse proxy de production (docker-compose.prod.yml, service caddy).
# DOMAINE : nom public de la VM (certificat TLS Let's Encrypt automatique) ; « localhost » sans
# domaine (certificat local, essai sur la VM elle-même).
{$DOMAINE:localhost} {
	encode zstd gzip

	# Rapports jusqu'à 50 Mo (app/company/upload_validation.py), avec une marge pour le formulaire.
	request_body {
		max_size 60MB
	}

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health {
		reverse_proxy api:8000
	}

	# Application monopage : toute autre route renvoie index.html (routage côté navigateur).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
