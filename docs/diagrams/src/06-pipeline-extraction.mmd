---
title: Flux de données — pipeline d'extraction ESG et scoring
---
flowchart TB
  subgraph S1["1 · Dépôt et mise en file (API)"]
    direction LR
    A["Entreprise dépose un PDF<br/>POST /reports/{id}/file · import URL"] --> B["upload_validation<br/>octets magiques · taille · SHA-256 unique"]
    B --> C[("storage<br/>rapport.pdf")]
    C --> D["Statut EXTRACTING<br/>enfiler_extraction()"]
    D --> Q[("Redis<br/>file extraction")]
    CRON["cron reprendre_extractions (5 min)<br/>échoue les bloqués · ré-enfile les perdus"] -.-> Q
  end

  subgraph S2["2 · run_extraction_pipeline — worker-extraction (app/ingestion)"]
    direction LR
    R0["extraction_runs : RUNNING<br/>versions Docling / LLM / prompt"] --> R1["Docling<br/>PDF → DoclingDocument"]
    R1 --> R2["Découpage par page<br/>chunks 1 200 car."]
    R2 --> R3["Embeddings bge-m3<br/>+ index FAISS<br/>recherche par indicateur"]
    R3 --> R4["Sélection adaptative<br/>des pages + voisines<br/>(budget tokens)"]
    R4 --> R5["Gemini tool-calling forcé<br/>valeurs + citation de page<br/>(secours / retry si quota)"]
    R5 --> R6["localisation<br/>boîtes de la valeur citée"]
    R6 --> R7["proof_generator<br/>extrait PDF de preuve"]
    R7 --> R8["completeness<br/>couverture par indicateur"]
  end

  subgraph S3["3 · Persistance, pré-score, audit et publication"]
    direction LR
    DB[("PostgreSQL<br/>esg_metrics · carbon_emissions<br/>evidence · metric_coverage")] --> SC["scoring.engine<br/>pré-score (config de référence)"]
    SC --> N["AWAITING_ASSIGNMENT<br/>(ou DRAFT si brouillon)<br/>notifications · job synthèse PDF"]
    N --> V1["Auditeur : revue de<br/>chaque valeur<br/>metric_reviews"]
    V1 --> V2["Avis d'audit<br/>PENDING_DECISION"]
    V2 --> V3["Admin valide<br/>valeur effective :<br/>auditée / extraite / exclue"]
    V3 --> V4["scores · official_score<br/>coverage_rate · config_hash"]
    V4 --> OUT["Consommateurs :<br/>investisseurs (PCAF),<br/>chercheurs, explicabilité"]
  end

  S1 ==>|"job extract_report"| S2
  S2 ==>|"remplacement atomique des valeurs"| S3
