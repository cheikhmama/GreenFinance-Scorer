erDiagram
  direction LR
  users {
    uuid id PK
  }
  companies {
    uuid id PK
    string name
    string sector
    string country
    string status "RegistrationStatus"
    uuid owner_user_id FK
    uuid onboarded_by_id FK
    string tax_id
