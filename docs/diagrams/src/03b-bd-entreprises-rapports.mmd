    string lei
    string ticker
    decimal minimum_investment_amount
    string mandate_letter_path
    datetime published_at
    datetime onboarded_at
    string rejection_reason
  }
  esg_reports {
    uuid id PK
    uuid company_id FK
    uuid auditor_id FK
    uuid previous_report_id FK
    uuid declared_global_score_proof_id FK
    string type
    string channel
    string status "ReportStatus"
    int fiscal_year
    int version
    string source_file
    string checksum_sha256
    datetime submitted_at
    int extraction_attempts
    string extraction_error
    float declared_global_score
    string synthesis_report_path
    decimal revenue
    decimal enterprise_value
    date evic_date
  }
  extraction_runs {
    uuid id PK
    uuid report_id FK
    string status "RUNNING SUCCEEDED FAILED RETRY_SCHEDULED"
    datetime started_at
    datetime finished_at
    string docling_version
    string llm_model
    string prompt_version
    string error
  }
  evidence {
    uuid id PK
    string document_name
    int year
    int total_pages
    int page_start
    int page_end
    string excerpt_pdf_path
  }
  esg_metrics {
    uuid id PK
    uuid report_id FK
    uuid proof_id FK
    uuid extraction_run_id FK
    string pillar "E S G"
    string metric_code
    float value
    string unit
    string method
    string raw_value
    string proof_text
    string confidence
    json proof_boxes
  }
  carbon_emissions {
    uuid id PK
    uuid report_id FK
    uuid proof_id FK
    uuid extraction_run_id FK
    int scope "1 2 3"
    string ghg_category
    float tonnes_co2e
    int year
    string method
    int pcaf_data_quality "1 à 5"
    json proof_boxes
  }
  metric_coverage {
    uuid id PK
    uuid report_id FK
    string metric_code
    string status
    int pages_examined
  }
  discrepancy_flags {
    uuid id PK
    uuid metric_id FK
    uuid company_id FK
    string nature
    string status
    datetime flagged_at
  }

