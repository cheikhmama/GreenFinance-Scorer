DATABASE_URL=postgresql+psycopg://greenfinance:changeme@localhost:5432/greenfinance
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
# SMTP : requis pour envoyer les liens de réinitialisation et les messages de contact.
# Laisser vide désactive l'envoi (503 explicite), sans empêcher le démarrage de l'API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587), ssl (465), plain (relais local de développement uniquement).
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM=
CONTACT_TO_EMAIL=
SECRET_KEY=changeme-dev-secret-key-at-least-32-bytes-long
MFA_ISSUER_NAME=GreenFinance-Scorer
GEMINI_API_KEY=gemini-api-key-example-replace-me
STORAGE_BACKEND=local
STORAGE_PATH=./storage
DEFAULT_SCORING_CONFIG=config/weights/default.yaml
FX_RATES_PATH=config/fx/rates.yaml
EMISSION_FACTORS_PATH=config/carbon/emission_factors.yaml
ENVIRONMENT=development
# Production Docker uniquement (docker-compose.prod.yml, tâche 4.2) : obligatoires, sans valeur par
# défaut — DATABASE_URL et REDIS_URL y sont reconstruits à partir d'eux. Inutiles en développement.
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# Lu par uvicorn (pas par l'application) : adresse(s) du reverse-proxy autorisé à fournir
# l'IP cliente via X-Forwarded-For. Les limites de débit par IP en dépendent. Défaut uvicorn :
# 127.0.0.1 seulement.
# FORWARDED_ALLOW_IPS=127.0.0.1
