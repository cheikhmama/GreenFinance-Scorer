DATABASE_URL=postgresql+psycopg://greenfinance:changeme@localhost:5432/greenfinance
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
# SMTP : requis pour envoyer les liens de réinitialisation, les messages de contact et les codes
# de vérification de l'inscription (tâche 5.11) — sans lui, toute inscription est refusée (503).
# En développement : Mailpit (`docker compose up -d mailpit`), boîte de réception sur
# http://localhost:8025 — MAIL_FROM=no-reply@greenfinance-demo.com, SMTP_HOST=localhost,
# SMTP_PORT=1025, SMTP_SECURITY=plain, sans identifiants. Les e-mails partent par le worker
# (`arq app.worker.settings.WorkerSettings`) : il doit tourner. SMTP_SECURITY=plain est refusé
# quand ENVIRONMENT=production.
# Laisser vide désactive l'envoi (503 explicite), sans empêcher le démarrage de l'API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587), ssl (465), plain (relais local de développement uniquement).
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM=
CONTACT_TO_EMAIL=
SECRET_KEY=changeme-dev-secret-key-at-least-32-bytes-long
MFA_ISSUER_NAME=GreenFinance-Scorer
GEMINI_API_KEY=gemini-api-key-example-replace-me
STORAGE_BACKEND=local
STORAGE_PATH=./storage
DEFAULT_SCORING_CONFIG=config/weights/default.yaml
FX_RATES_PATH=config/fx/rates.yaml
EMISSION_FACTORS_PATH=config/carbon/emission_factors.yaml
ENVIRONMENT=development
# Contrôle KYC des inscriptions (tâche 5.3) — valeurs par défaut suffisantes.
# GLEIF_API_URL=https://api.gleif.org/api/v1
# GLEIF_TIMEOUT_SECONDS=5
# Production Docker uniquement (docker-compose.prod.yml, tâche 4.2) : obligatoires, sans valeur par
# défaut — DATABASE_URL et REDIS_URL y sont reconstruits à partir d'eux. Inutiles en développement.
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# Lu par uvicorn (pas par l'application) : adresse(s) du reverse-proxy autorisé à fournir
# l'IP cliente via X-Forwarded-For. Les limites de débit par IP en dépendent. Défaut uvicorn :
# 127.0.0.1 seulement.
# FORWARDED_ALLOW_IPS=127.0.0.1
