# @tremor/react (posé comme dépendance pour les futurs graphiques, non utilisé pour
# l'instant) déclare un peerDependency react@^18 alors que ce projet est sur React 19
# (choix par défaut du template Vite react-ts au moment du scaffold). Tremor fonctionne
# en pratique avec React 19 ; ce n'est qu'une annonce de peer dependency pas encore mise
# à jour côté Tremor. legacy-peer-deps évite de devoir répéter --legacy-peer-deps à
# chaque installation.
legacy-peer-deps=true
